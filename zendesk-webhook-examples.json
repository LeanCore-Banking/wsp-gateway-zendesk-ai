  "testing_instructions": {
    "description": "Cómo probar estos ejemplos",
    "steps": [
      "1. Iniciar el servidor en modo desarrollo: yarn start:dev",
      "2. Usar curl o Postman para enviar los payloads",
      "3. Observar los logs del servidor para ver el procesamiento completo",
      "4. Verificar que las respuestas se generen correctamente"
    ],
    "curl_example": "curl -X POST http://localhost:3000/webhook/zendesk/whatsapp -H 'Content-Type: application/json' -d @zendesk-webhook-examples.json#example_1_whatsapp_message.payload"
