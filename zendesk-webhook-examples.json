{
  "example_1_whatsapp_message": {
    "description": "Ejemplo de webhook cuando un cliente envía un mensaje por WhatsApp a través del canal de Zendesk",
    "payload": {
      "id": "12345",
      "type": "ticket_comment",
      "ticket_id": "12345",
      "message": "Hola, necesito ayuda con mi crédito 577b35a6",
      "via": {
        "channel": "whatsapp",
        "source": {
          "from": {
            "phone": "+573001234567",
            "name": "Juan Pérez"
          },
          "to": {
            "phone": "+14155238886"
          }
        }
      },
      "author": {
        "id": "67890",
        "name": "Juan Pérez",
        "role": "end_user"
      },
      "ticket": {
        "id": "12345",
        "subject": "WhatsApp conversation with Juan Pérez",
        "status": "new",
        "priority": "normal",
        "custom_fields": [
          {
            "id": "whatsapp_number",
            "value": "+573001234567"
          }
        ]
      }
    }
  },
