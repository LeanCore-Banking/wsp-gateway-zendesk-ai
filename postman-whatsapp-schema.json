            "SmsStatus": "received",
            "NumSegments": "1",
            "MessageType": "text"
          }
        }
      ]
    }
  },
  "postman_collection": {
    "info": {
      "name": "WhatsApp Credit Repair Flow",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      {
        "key": "base_url",
        "value": "http://localhost:3000",
        "description": "URL base del servidor local"
      }
    ],
    "item": [
      {
        "name": "1. Solicitud Inicial de Arreglo de Crédito",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ],
          "body": {
            "mode": "urlencoded",
            "urlencoded": [
              {"key": "MessageSid", "value": "SM{{$randomUUID}}", "type": "text"},
              {"key": "AccountSid", "value": "AC{{$randomAlphaNumeric}}", "type": "text"},
              {"key": "From", "value": "whatsapp:+573001234567", "type": "text"},
              {"key": "To", "value": "whatsapp:+57300XXXXXXX", "type": "text"},
              {"key": "Body", "value": "Hola, necesito ayuda para arreglar mi crédito. Tengo problemas con mi préstamo.", "type": "text"},
              {"key": "NumMedia", "value": "0", "type": "text"},
              {"key": "ProfileName", "value": "Juan Pérez", "type": "text"},
              {"key": "WaId", "value": "573001234567", "type": "text"},
              {"key": "SmsStatus", "value": "received", "type": "text"},
              {"key": "NumSegments", "value": "1", "type": "text"},
              {"key": "MessageType", "value": "text", "type": "text"}
            ]
          },
          "url": {
            "raw": "{{base_url}}/webhook/twilio/whatsapp",
            "host": ["{{base_url}}"],
            "path": ["webhook", "twilio", "whatsapp"]
          }
        }
      },
      {
        "name": "2. Usuario Proporciona ID de Préstamo",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ],
          "body": {
            "mode": "urlencoded",
            "urlencoded": [
              {"key": "MessageSid", "value": "SM{{$randomUUID}}", "type": "text"},
              {"key": "AccountSid", "value": "AC{{$randomAlphaNumeric}}", "type": "text"},
              {"key": "From", "value": "whatsapp:+573001234567", "type": "text"},
              {"key": "To", "value": "whatsapp:+57300XXXXXXX", "type": "text"},
              {"key": "Body", "value": "Mi ID de préstamo es 577b35a6", "type": "text"},
              {"key": "NumMedia", "value": "0", "type": "text"},
              {"key": "ProfileName", "value": "Juan Pérez", "type": "text"},
              {"key": "WaId", "value": "573001234567", "type": "text"},
              {"key": "SmsStatus", "value": "received", "type": "text"},
              {"key": "NumSegments", "value": "1", "type": "text"},
              {"key": "MessageType", "value": "text", "type": "text"}
            ]
          },
          "url": {
            "raw": "{{base_url}}/webhook/twilio/whatsapp",
            "host": ["{{base_url}}"],
            "path": ["webhook", "twilio", "whatsapp"]
          }
        }
      },
      {
        "name": "3. Solicitud de Reestructuración",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ],
          "body": {
            "mode": "urlencoded",
            "urlencoded": [
              {"key": "MessageSid", "value": "SM{{$randomUUID}}", "type": "text"},
              {"key": "AccountSid", "value": "AC{{$randomAlphaNumeric}}", "type": "text"},
              {"key": "From", "value": "whatsapp:+573001234567", "type": "text"},
              {"key": "To", "value": "whatsapp:+57300XXXXXXX", "type": "text"},
              {"key": "Body", "value": "He tenido dificultades para pagar. ¿Pueden ayudarme a reestructurar mi deuda?", "type": "text"},
              {"key": "NumMedia", "value": "0", "type": "text"},
              {"key": "ProfileName", "value": "Juan Pérez", "type": "text"},
              {"key": "WaId", "value": "573001234567", "type": "text"},
              {"key": "SmsStatus", "value": "received", "type": "text"},
              {"key": "NumSegments", "value": "1", "type": "text"},
              {"key": "MessageType", "value": "text", "type": "text"}
            ]
          },
          "url": {
            "raw": "{{base_url}}/webhook/twilio/whatsapp",
            "host": ["{{base_url}}"],
            "path": ["webhook", "twilio", "whatsapp"]
          }
        }
      }
    ]
  },
  "testing_instructions": {
    "setup": [
      "1. Asegúrate de que el servidor esté ejecutándose en el puerto 3000",
      "2. Configura la variable de entorno base_url en Postman como http://localhost:3000",
      "3. Importa la colección de Postman usando el JSON proporcionado"
    ],
    "execution": [
      "1. Ejecuta las peticiones en orden secuencial para simular una conversación",
      "2. Revisa los logs en la consola del servidor para seguir el flujo",
      "3. Verifica que se ejecuten las funciones de búsqueda de préstamos",
      "4. Confirma que se generen tickets en Zendesk cuando corresponda"
    ],
    "monitoring": [
      "1. Observa los logs del webhook controller para ver los datos recibidos",
      "2. Sigue los logs del message processor para ver el procesamiento",
      "3. Revisa los logs del function calling service para ver las búsquedas de préstamos",
      "4. Verifica las respuestas de WhatsApp en los logs de Twilio service"
    ]
  }
}