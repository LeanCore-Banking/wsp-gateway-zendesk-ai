{
  "info": {
    "name": "WhatsApp Twilio Webhook - Flujo Arreglo de Crédito",
    "description": "Esquema para simular mensajes de WhatsApp desde Twilio para probar el flujo de arreglo de crédito",
    "version": "1.0.0"
  },
  "scenarios": {
    "credit_repair_flow": {
      "description": "Flujo completo de arreglo de crédito - desde solicitud inicial hasta búsqueda de préstamo",
      "steps": [
        {
          "step": 1,
          "description": "Mensaje inicial solicitando arreglo de crédito",
          "method": "POST",
          "url": "{{base_url}}/webhook/twilio/whatsapp",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": {
            "MessageSid": "SM{{$randomUUID}}",
            "AccountSid": "AC{{$randomAlphaNumeric}}",
            "From": "whatsapp:+573001234567",
            "To": "whatsapp:+57300XXXXXXX",
            "Body": "Hola, necesito ayuda para arreglar mi crédito. Tengo problemas con mi préstamo y no sé qué hacer.",
            "NumMedia": "0",
            "ProfileName": "Juan Pérez",
            "WaId": "573001234567",
            "SmsStatus": "received",
            "NumSegments": "1",
            "MessageType": "text"
          }
        },
        {
          "step": 2,
          "description": "Respuesta del usuario proporcionando ID parcial del préstamo",
          "method": "POST",
          "url": "{{base_url}}/webhook/twilio/whatsapp",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": {
            "MessageSid": "SM{{$randomUUID}}",
            "AccountSid": "AC{{$randomAlphaNumeric}}",
            "From": "whatsapp:+573001234567",
            "To": "whatsapp:+57300XXXXXXX",
            "Body": "Mi ID de préstamo es 577b35a6",
            "NumMedia": "0",
            "ProfileName": "Juan Pérez",
            "WaId": "573001234567",
            "SmsStatus": "received",
            "NumSegments": "1",
            "MessageType": "text"
          }
        },
        {
          "step": 3,
          "description": "Usuario proporciona más información sobre su situación",
          "method": "POST",
          "url": "{{base_url}}/webhook/twilio/whatsapp",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": {
            "MessageSid": "SM{{$randomUUID}}",
            "AccountSid": "AC{{$randomAlphaNumeric}}",
            "From": "whatsapp:+573001234567",
            "To": "whatsapp:+57300XXXXXXX",
            "Body": "He tenido dificultades para pagar las cuotas debido a problemas económicos. ¿Pueden ayudarme a reestructurar mi deuda?",
            "NumMedia": "0",
            "ProfileName": "Juan Pérez",
            "WaId": "573001234567",
            "SmsStatus": "received",
            "NumSegments": "1",
            "MessageType": "text"
          }
        }
      ]
    },
    "single_message_examples": {
      "description": "Ejemplos de mensajes individuales para diferentes escenarios",
      "examples": [
        {
          "name": "Solicitud inicial de arreglo de crédito",
          "body": {
            "MessageSid": "SM1234567890abcdef1234567890abcdef",
            "AccountSid": "AC1234567890abcdef1234567890abcdef",
            "From": "whatsapp:+573001234567",
